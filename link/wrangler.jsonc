{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-link",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "durable_objects": {
    "bindings": [
      { "name": "NEXUS_ROOMS", "class_name": "NexusRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NexusRoom"]
    }
  ]
}
