PORT=3000
NODE_ENV=production
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# Use a unique password of at least 12 characters.
ADMIN_PASSWORD=replace_with_a_long_unique_password
# Set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0
DATA_DIR=/app/data
